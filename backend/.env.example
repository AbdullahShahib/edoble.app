# Cloudflare R2 (optional, S3-compatible)
# If using R2, set R2_ACCOUNT_ID and R2 keys. R2_ENDPOINT can be left empty to use
# the default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

## For cPanel MySQL use (example):
## DATABASE_URL="mysql://dbuser:dbpass@127.0.0.1:3306/edoble"
## If you prefer SQLite for local dev, keep the default below:
DATABASE_URL=file:./dev.db

# Cookie config for refresh token handling
COOKIE_DOMAIN=        # e.g. your-domain.com
COOKIE_SECURE=true     # set to false only for local non-HTTPS testing
PORT=4000
JWT_SECRET=change_me_to_a_strong_secret
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=1209600
REDIS_URL=redis://localhost:6379
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 (optional, S3-compatible)
# If using R2, set R2_ACCOUNT_ID and R2 keys. R2_ENDPOINT can be left empty to use
# the default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
