# Multi-stage Dockerfile for building and serving the Expo web output
FROM node:18-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

# Build web assets - adjust command for your project (expo export:web or other)
RUN npm run build:web --if-present || npm run web:build --if-present || echo "No web build command; ensure web assets are prepared"

FROM nginx:stable-alpine
COPY --from=builder /app/web-build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
